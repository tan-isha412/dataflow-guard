# Copy to .env in this directory. The worker is a separate process
# from the API (src/config/connection.js) and needs its own copy of
# these — it does not import apps/api's config.

# Required — Prisma reads this directly (schema.prisma's env("DATABASE_URL")).
# Same database the API writes to; the worker only processes jobs
# against org data that's already there.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dataflow_guardian

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
