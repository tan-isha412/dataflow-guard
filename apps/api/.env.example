# Copy to .env in this directory. Every var here is read by
# src/config/env.js (a zod schema — the app refuses to start if a
# required one is missing or malformed).

NODE_ENV=development
API_PORT=5000
API_PREFIX=/api/v1

# Required. Local dev matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dataflow_guardian

# Local dev Redis has no auth/TLS — REDIS_PASSWORD/REDIS_TLS are only
# needed against a managed instance (e.g. AWS ElastiCache with AUTH).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Required. Generate real random secrets for anything beyond local dev —
# these values are NOT safe to use anywhere but your own machine.
JWT_ACCESS_SECRET=change-me-to-a-real-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-real-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of origins allowed by CORS (middleware/app.js).
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiter thresholds (middleware/rateLimit.js) — requests per 60s
# window. Defaults shown; only override for a controlled local load
# test (see scripts/loadtest.js) or a deliberately different production
# policy. Changing these does NOT affect security — the inspection
# pipeline's fail-closed behavior is the actual security boundary; the
# rate limiter is abuse-resistance and fails open if Redis is down.
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_LOGIN_MAX=10
