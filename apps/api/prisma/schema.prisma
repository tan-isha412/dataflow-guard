generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String       @id @default(uuid())
  name         String
  createdAt    DateTime     @default(now())
  // Phase 6 privacy configuration: how long audit events/decisions are
  // kept before an automatic sweep deletes them (worker/processors/
  // auditAggregation.processor.js). null = retain indefinitely — an org
  // has to opt IN to automatic deletion, never the other way around.
  // Note there is no "retain raw prompt content" toggle here: the system
  // never stores raw prompt content anywhere (see docs/privacy.md), so a
  // flag claiming to control that would control nothing real.
  auditRetentionDays Int?
  memberships  Membership[]
  policies     Policy[]
  decisions    Decision[]
  destinations Destination[]
  approvals    Approval[]
  auditEvents  AuditEvent[]
  @@map("organizations")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  fullName     String
  createdAt    DateTime     @default(now())
  memberships  Membership[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid())
  role           String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Policy {
  id             String   @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  description    String?
  priority       Int      @default(0)
  enabled        Boolean  @default(true)
  conditions     Json
  action         String
  createdAt      DateTime @default(now())

  // Every real query in policy.repository.js filters on organizationId
  // (org isolation is enforced at the query level, not just checked
  // after fetching) — without this index, that WHERE clause is a full
  // table scan once an org's policy table grows past a trivial size.
  // Prisma does NOT create an index on a plain foreign-key scalar column
  // automatically (only @id/@unique get one) — confirmed missing via
  // `\d policies` against the live schema before this change.
  @@index([organizationId])
  @@map("policies")
}
model Decision {
  id               String       @id @default(uuid())
  organization     Organization @relation(fields: [organizationId], references: [id])
  organizationId   String
  action           String
  status           String
  riskScore        Int
  reason           String
  matchedPolicyIds Json
  detections       Json
  sanitizedContent String?
  createdAt        DateTime     @default(now())

  // audit.repository.js and analytics.repository.js both filter by
  // organizationId and then order/aggregate by createdAt (dashboard
  // history, decisionsGroupedByDay, countDecisionsByOrganization) — a
  // composite index serves both the equality filter and the range/sort
  // in one pass, and a plain organizationId index would still be
  // needed as its prefix for the count()/aggregate() calls that don't
  // touch createdAt at all.
  @@index([organizationId, createdAt])
  @@map("decisions")
}

model Destination {
  id               String       @id @default(uuid())
  organization     Organization @relation(fields: [organizationId], references: [id])
  organizationId   String
  name             String
  type             String
  baseUrl          String?
  status           String       @default("UNAPPROVED")
  riskLevel        String       @default("MEDIUM")
  allowedDataTypes Json
  createdAt        DateTime     @default(now())

  @@index([organizationId])
  @@map("destinations")
}

model Approval {
  id                String       @id @default(uuid())
  organization      Organization @relation(fields: [organizationId], references: [id])
  organizationId    String
  requestedByUserId String
  decidedByUserId   String?
  status            String       @default("PENDING")
  reason            String
  detections        Json
  destinationId     String?
  createdAt         DateTime     @default(now())
  decidedAt         DateTime?
  expiresAt         DateTime

  // findApprovalsByOrganization filters organizationId + optional
  // status, ordered by createdAt desc (the approvals dashboard/queue) —
  // status is low-cardinality (4 values) so it's not its own index, but
  // pairing it after organizationId still lets Postgres narrow within
  // one org's rows before the sort.
  @@index([organizationId, status])
  @@map("approvals")
}

model AuditEvent {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  actorUserId    String?
  eventType      String
  metadata       Json
  createdAt      DateTime     @default(now())

  // Every audit query (findAuditEventsByOrganization, countActiveUsers,
  // listDestinationsSeen) filters organizationId + a createdAt range,
  // then orders by createdAt — this is the table Phase 6's automatic
  // retention sweep also scans by organizationId + createdAt, and the
  // one most likely to grow large in a real deployment (an event per
  // inspection), so it's the highest-value index in this schema.
  @@index([organizationId, createdAt])
  @@map("audit_events")
}