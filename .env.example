# Copy this file to .env in the relevant app directory (or the repo
# root, for docker-compose) and fill in real values. Never commit an
# actual .env file — see .gitignore, which already excludes them.
#
# Every variable below is one an actual piece of code in this repo
# reads. If a variable isn't listed here, no code path uses it — this
# file deliberately does not carry placeholders for integrations
# (OAuth providers, an LLM API, S3, SQS, a generic "encryption key")
# that were never actually implemented; adding config for
# functionality that doesn't exist is more misleading than having no
# entry at all.

# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development


# ==========================================
# API (apps/api/src/config/env.js)
# ==========================================

API_PORT=5000
API_PREFIX=/api/v1


# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_USER=dataflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dataflow_guardian
POSTGRES_PORT=5432

# Consumed directly by Prisma (apps/api/prisma/schema.prisma) and the
# worker. Local/dev value shown; in production this should point at
# the managed RDS instance (see infra/aws/rds.tf) and be injected via
# Secrets Manager (infra/aws/secrets.tf), never typed into a real .env.
DATABASE_URL=postgresql://dataflow:change_me@localhost:5432/dataflow_guardian


# ==========================================
# REDIS
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" only against a Redis that actually terminates TLS (e.g.
# AWS ElastiCache with transit_encryption_enabled — see
# infra/aws/elasticache.tf). Leave unset/false for local/dev Redis.
REDIS_TLS=false


# ==========================================
# JWT (apps/api/src/modules/auth/jwt.util.js)
# ==========================================

# Generate real values with e.g. `openssl rand -base64 48` — never reuse
# the placeholder below, and never let access/refresh share a value.
JWT_ACCESS_SECRET=replace_with_a_real_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_real_random_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ==========================================
# SECURITY / CORS (apps/api/src/app.js)
# ==========================================

# Comma-separated allowlist passed straight to the `cors` package's
# `origin` option — never "*" for this API, since every route past
# /health requires a bearer token and a wildcard origin combined with
# credentialed requests is exactly the CSRF-adjacent misconfiguration
# CORS exists to prevent. The React dev server's origin locally; the
# real dashboard origin in production (and see docs/deployment.md for
# why the browser extension itself normally does NOT need an entry
# here — MV3 host_permissions fetches bypass CORS entirely).
ALLOWED_ORIGINS=http://localhost:5173


# ==========================================
# WEB (apps/web) — build-time only, read by vite.config.js/import.meta.env
# ==========================================

# Not currently used: apps/web/src/api/client.js's apiClient.baseURL is
# the relative path "/api/v1" (proxied to the API by vite.config.js in
# dev, and by the production reverse proxy / CloudFront behavior — see
# docs/deployment.md) rather than an absolute URL read from an env var,
# so there is deliberately no VITE_API_URL here. Listed to make that
# choice explicit rather than something a reader has to go verify.


# ==========================================
# EXTENSION (apps/extension) — build-time only, see scripts/build.js
# ==========================================

# Not read from a .env file at all — the extension has no server-side
# process to read one. A production build instead takes this as a
# literal environment variable passed to the build command itself:
#   API_BASE_URL=https://api.yourcompany.com/api/v1 \
#     npm run build:production --workspace=@dataflow-guardian/extension
# See apps/extension/README.md's "Production build" section.


# ==========================================
# LOGGING
# ==========================================

# debug | info | warn | error — see apps/api/utils/logger.js
LOG_LEVEL=info
