# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
APP_NAME=DataFlow Guardian
APP_URL=http://localhost:5173


# ==========================================
# API
# ==========================================

API_PORT=5000
API_URL=http://localhost:5000
API_PREFIX=/api/v1


# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_USER=dataflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dataflow_guardian
POSTGRES_PORT=5432

DATABASE_URL=postgresql://dataflow:change_me@localhost:5432/dataflow_guardian


# ==========================================
# REDIS
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# ==========================================
# JWT
# ==========================================

JWT_ACCESS_SECRET=replace_with_secure_secret
JWT_REFRESH_SECRET=replace_with_secure_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ==========================================
# OAUTH / GOOGLE
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback


# ==========================================
# OAUTH / MICROSOFT
# ==========================================

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/v1/auth/microsoft/callback


# ==========================================
# AI / LLM
# ==========================================

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=


# ==========================================
# AWS
# ==========================================

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_S3_BUCKET=
AWS_SQS_QUEUE_URL=
AWS_SECRETS_MANAGER_SECRET_NAME=


# ==========================================
# SECURITY
# ==========================================

ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100


# ==========================================
# LOGGING / MONITORING
# ==========================================

LOG_LEVEL=info